{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/imp/schemas/metabolism-cycle-conformance-case.schema.json",
  "title": "IMP Metabolism Cycle Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "cycle_record_path",
    "governor_assessment_path",
    "handoff_event_path",
    "audit_record_path",
    "purification_record_path",
    "output_state_packet_path",
    "expected_result",
    "expected_violation_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^cyclecase_[A-Za-z0-9._-]+$"
    },
    "cycle_record_path": {
      "type": "string",
      "minLength": 1
    },
    "governor_assessment_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "handoff_event_path": {
      "type": "string",
      "minLength": 1
    },
    "audit_record_path": {
      "type": "string",
      "minLength": 1
    },
    "purification_record_path": {
      "type": "string",
      "minLength": 1
    },
    "output_state_packet_path": {
      "type": "string",
      "minLength": 1
    },
    "expected_result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "expected_violation_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CYCLE_GENERATION_MISMATCH",
          "CYCLE_RECORD_REFERENCE_MISMATCH",
          "CYCLE_TRIGGER_MISMATCH",
          "CYCLE_GOVERNOR_MISMATCH",
          "CYCLE_HANDOFF_MODE_MISMATCH",
          "CYCLE_AUDIT_NOT_ELIGIBLE",
          "CYCLE_PURIFICATION_NOT_READY",
          "CYCLE_PACKET_NOT_VERIFIED",
          "CYCLE_GOAL_MISMATCH",
          "CYCLE_RAW_TRACE_INHERITED",
          "CYCLE_EVIDENCE_NOT_PRESERVED",
          "CYCLE_CROSS_RECORD_FAILURE",
          "CYCLE_OUTCOME_INVALID"
        ]
      }
    }
  }
}
